generator client {
  provider        = "prisma-client-js"
  // relationJoins lets hot reads (FULL_EMPIRE_INCLUDE, run on every /game page
  // load) fetch all relations in one JOINed query via relationLoadStrategy:
  // "join", instead of Prisma's default one-query-per-relation (~10 round-trips).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"

  // These deliberately do NOT use the names `DATABASE_URL` / `DIRECT_URL`.
  //
  // The database is provisioned through the Vercel↔Neon marketplace
  // integration, which owns and re-syncs its own `DATABASE_URL`,
  // `DATABASE_URL_UNPOOLED`, `POSTGRES_*`, `PG*` and `NEON_PROJECT_ID` vars in
  // the Vercel project. A hand-edited `DATABASE_URL` therefore collides with
  // the integration's copy, and any manual edit to it — notably the
  // `pgbouncer=true` below — is liable to be silently overwritten on the next
  // sync. Reading names the integration does not manage makes the app's
  // connection config ours alone.
  //
  // Pooled connection (Neon's -pooler host in prod), used by the running app.
  // MUST carry `?pgbouncer=true`: the pooler is PgBouncer in transaction mode,
  // where Prisma's prepared statements collide across sessions and surface as
  // `prepared statement "s0" already exists` under concurrency only.
  url = env("PRISMA_DATABASE_URL")

  // Unpooled connection used by `prisma migrate` — migrations take advisory
  // locks, which a transaction-mode pooler cannot hold. No `pgbouncer=true`
  // here. Locally this is just the same URL as PRISMA_DATABASE_URL.
  directUrl = env("PRISMA_DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Null for accounts that only sign in with Google (no password set). A
  /// password account and a Google identity can coexist on one row once linked
  /// by verified email — see src/server/actions/auth.ts (googleSignIn).
  passwordHash  String?
  /// Google account subject (`sub` claim), set when the user links/signs up with
  /// Google. Unique so one Google account maps to at most one user.
  googleId      String?   @unique
  /// Optional avatar URL supplied by Google at sign-in.
  image         String?
  name          String
  role          Role      @default(USER)
  /// When the ban was handed down. Never a ban check on its own — see
  /// `bannedUntil` and `isBanned()` in src/lib/ban.ts.
  bannedAt      DateTime?
  /// When a ban lifts by itself; null while `bannedAt` is set means permanent.
  /// A ban is live only while `bannedAt != null && (bannedUntil == null ||
  /// bannedUntil > now)` — nothing sweeps expired rows, so every read evaluates
  /// the deadline instead of trusting `bannedAt`.
  bannedUntil   DateTime?
  /// Bumped to invalidate every previously-issued session JWT (stateless, so a
  /// token stays valid until expiry otherwise). Embedded as the `ver` claim at
  /// sign time and re-checked on every request; a password reset increments it,
  /// logging out all existing sessions. See src/lib/auth.ts.
  tokenVersion  Int       @default(0)
  /// Consecutive failed password attempts since the last success. Reset to 0 on
  /// a successful login. Backs the account lockout in src/server/actions/auth.ts
  /// — the in-process rate limiter cannot throttle brute force on a serverless
  /// fleet, because each instance keeps its own counters and loses them on cold
  /// start, so the durable counter lives here instead.
  failedLogins  Int       @default(0)
  /// Set while the account is locked out; login is refused until it passes.
  lockedUntil   DateTime?
  /// When the user proved control of this address. Null = unverified, which
  /// blocks all gameplay (see requireEmpire / getActiveEmpireId). Google
  /// sign-ins are verified on arrival via the provider's email_verified claim.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empire             Empire?
  verificationTokens EmailVerificationToken[]
}

/// One outstanding "confirm your email" link.
model EmailVerificationToken {
  id String @id @default(cuid())

  userId     String
  /// SHA-256 of the token that was emailed — the raw value is never stored, so
  /// read access to this table cannot be replayed into an account takeover.
  /// Unique so a lookup by hash is a single indexed read.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment the link is used; a consumed token is never accepted again.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-row (`id = "singleton"`) table holding admin-editable global game
/// balance. `data` is a JSON overlay merged over DEFAULT_TUNABLES in code —
/// see src/lib/game/config.ts.
model GameConfig {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum MiniGameType {
  GUESS_NUMBER
  FIND_BALL
}

/// An admin-authored mini-game event (guess-the-number / find-the-ball). When
/// `isActive`, it shows as a big panel at the top of every player's screen and
/// grants the prize bundle to winners. `config` holds the secret answer +
/// public params ({min,max,answer} or {cups,answer}) — never send answer to
/// the client.
model MiniGameEvent {
  id           String       @id @default(cuid())
  type         MiniGameType
  title        String
  config       Json
  maxAttempts  Int          @default(5)
  /// 0 = unlimited winners.
  maxWinners   Int          @default(0)
  winnersCount Int          @default(0)
  isActive     Boolean      @default(false)

  /// How long a release lasts, in minutes (0 = until the admin stops it). Kept
  /// on the event so re-activating it reuses the last chosen duration.
  durationMinutes Int @default(0)

  prizeGold       Float @default(0)
  prizeWood       Float @default(0)
  prizeIron       Float @default(0)
  prizeStone      Float @default(0)
  prizeDiamonds   Float @default(0)
  prizeCitizens   Int   @default(0)
  prizeTurns      Int   @default(0)
  prizeWheelSpins Int   @default(0)

  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  /// When a timed release auto-expires (null = no deadline). Read as the real
  /// gate alongside `isActive`; the flag is flipped lazily on first read after.
  endsAt      DateTime?
  endedAt     DateTime?
  updatedAt   DateTime  @updatedAt

  entries MiniGameEntry[]

  @@index([isActive])
}

/// One player's participation in a mini-game event (attempts + win state).
model MiniGameEntry {
  id        String    @id @default(cuid())
  eventId   String
  empireId  String
  attempts  Int       @default(0)
  solved    Boolean   @default(false)
  won       Boolean   @default(false)
  wonAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event MiniGameEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, empireId])
  @@index([eventId])
}

/// Append-only trail of every mutating admin action, for accountability.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  /// e.g. "empire", "user", "season", "guild", "broadcast", "config".
  targetType String?
  targetId   String?
  /// Human-readable summary shown in the audit log UI.
  summary    String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

model GameSeason {
  id        String   @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stamped the moment the season's clock runs out and its final standings
  /// were archived. Non-null is the whole gate: a closed active season shuts
  /// every game screen until the next season opens (see server/seasonClose.ts).
  /// Writing it is the mutex — the close runs lazily on whichever page load
  /// first crosses `endsAt`, and a guarded `updateMany(closedAt: null)` makes
  /// sure only one of a hundred simultaneous loads does the archiving.
  closedAt DateTime?

  /// The end-of-season story, frozen at closing time: the categories, the
  /// totals, and the podium as it stood. Denormalised on purpose — the admin's
  /// season reset deletes every empire, so nothing on this page may be a join.
  /// Shape: `SeasonRecap` in src/server/seasonClose.ts.
  recap Json?

  empires Empire[]
}

/// One podium place of a finished season — the durable record behind היכל
/// התהילה. Written once, when the season is archived, and never updated: the
/// board is a record of who topped each season, not a live ranking.
///
/// **Nothing here is a relation, on purpose.** Not `empireId` (the next season
/// reset deletes every Empire row) and not `seasonId` (an admin may delete the
/// GameSeason itself, and the point of "save before deleting" is precisely that
/// the record outlives it). Every column is a snapshot, including the season's
/// own name and dates; the ids are historical breadcrumbs, never join keys.
/// A hall that could be emptied by a cascade would not be a hall.
model SeasonChampion {
  /// The GameSeason this was archived from. Unconstrained — the row it names
  /// may be long gone.
  seasonId       String
  seasonName     String
  seasonStartsAt DateTime
  seasonEndsAt   DateTime

  id String @id @default(cuid())

  /// 1, 2 or 3. The unique below is what makes archiving idempotent when the
  /// same season is archived twice (admin first, clock second).
  rank Int

  empireId   String?
  empireName String
  /// Owner's display name at archiving time, so the hall names a player and
  /// not only an empire.
  playerName String?
  guildName  String?

  /// Final standing figures, exactly as the ladder ranked them.
  power     Float
  cities    Int
  heroLevel Int

  createdAt DateTime @default(now())

  @@unique([seasonId, rank])
  /// The hall reads newest season first.
  @@index([seasonEndsAt])
}

model Empire {
  id                  String    @id @default(cuid())
  userId              String    @unique
  seasonId            String?
  name                String    @unique
  level               Int       @default(1)
  gold                Float     @default(2000)
  wood                Float     @default(1500)
  iron                Float     @default(1000)
  stone               Float     @default(1000)
  diamonds            Float     @default(10)
  citizens            Int       @default(50)
  /// Cities the empire holds (1..MAX_CITIES). Each city adds 100 to the
  /// citizen capacity, so ten cities ceiling the population at 1,000.
  cities              Int       @default(1)
  turns               Int       @default(0)
  /// Remaining wheel-of-fortune spins. Consumed on each spin, topped up on
  /// every daily update (capped) — see WHEEL_DAILY_SPINS / WHEEL_SPINS_CAP.
  wheelSpins          Int       @default(4)
  lastRegularUpdateAt DateTime  @default(now())
  lastDailyUpdateAt   DateTime  @default(now())
  /// Last time the player opened the reports page — drives the "new reports" badge.
  reportsSeenAt       DateTime  @default(now())
  /// Heartbeat behind the chat's online dot. Stamped by the chat poll every
  /// PRESENCE_TOUCH_MS at most (a guarded updateMany that usually matches no
  /// row), so "online" means a browser actually had the game open in the last
  /// few minutes.
  ///
  /// It has to be its own column: `updatedAt` moves whenever anything writes to
  /// the empire — a plunder, an admin gift, a settle — so presence read from it
  /// would light up players who are asleep and being raided.
  lastSeenAt          DateTime?
  /// New-player shield: while this is in the future the empire cannot be
  /// attacked or spied. Set at registration; cleared early the moment the
  /// player launches their own first attack or spy (see attackEmpire/spyOnEmpire).
  protectedUntil      DateTime?
  /// Denormalised power figures, kept in step by syncEmpirePower.
  ///
  /// These are pure functions of the army and the arsenal (see lib/game/power),
  /// but they are computed in JS, so without them no ranked query could be
  /// answered in SQL: every board had to load every empire in scope *plus every
  /// row of its arsenal*, sort in memory, and throw away all but the top rows.
  /// Storing them turns each board into an indexed ORDER BY … LIMIT.
  ///
  /// The risk they carry is drift: a write path that changes soldiers, spies or
  /// weapons and forgets to re-sync leaves a silently wrong ladder with no error
  /// anywhere. Two things contain that — every mutation goes through
  /// `syncEmpirePower`, and `applyPendingUpdates` re-derives them on every
  /// settle from data it has already loaded, so drift self-heals on the owner's
  /// next page load.
  militaryPower       Float     @default(0)
  generalPower        Float     @default(0)
  spyPower            Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        GameSeason?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  buildings     Building[]
  army          Army?
  storages      ResourceStorage[]
  upgrades      EmpireUpgrade[]
  bankAccount   BankAccount?
  weapons       EmpireWeapon[]
  weaponUnlocks EmpireWeaponUnlock[]
  hero          Hero?

  spyReportsSent     SpyReport[]         @relation("SpyAttacker")
  spyReportsReceived SpyReport[]         @relation("SpyDefender")
  battlesAttacked    BattleReport[]      @relation("BattleAttacker")
  battlesDefended    BattleReport[]      @relation("BattleDefender")
  messages           Message[]           @relation("MessageInbox")
  messagesSent       Message[]           @relation("MessageSender")
  chatSent           ChatMessage[]       @relation("ChatSender")
  chatReceived       ChatMessage[]       @relation("ChatRecipient")
  chatTyping         ChatTyping?
  guildMembership    GuildMember?
  guildInvites       GuildInvite[]       @relation("GuildInviteTo")
  guildInvitesSent   GuildInvite[]       @relation("GuildInviteFrom")
  guildBuffs         GuildSpellBuff[]
  diamondEffects     DiamondEffect[]
  potions            PotionStack[]
  potionEffects      PotionEffect[]
  diamondPurchases   DiamondPurchase[]
  seasonPass         SeasonPassProgress?
  bossFights         BossFight[]
  bossSieges         BossSiege[]
  bossBattles        BossBattle[]
  achievements       EmpireAchievement[]
  gloryAwards        EmpireGloryAward[]
  heroQuest          HeroQuest?

  // Rankings filters empires by city; admin broadcast/gift/reset scope by
  // season. Without these, both are full-table scans that grow with the player
  // base. The composite also serves the (now-removed) stale-daily settle query.
  @@index([cities, lastDailyUpdateAt])
  @@index([seasonId])
  /// The city ladder: rank inside one city tier.
  @@index([cities, militaryPower])
  /// The cross-game boards.
  @@index([generalPower])
  @@index([spyPower])
  /// The chat roster: who is online, then who was here most recently.
  @@index([lastSeenAt])
}

/// A single collected achievement. The row IS the receipt: nothing is written
/// until the player presses "collect".
///
/// Deliberately there is no progress column. Every achievement's condition is
/// *derived on read* from data the game already stores (battle reports, spy
/// reports, buildings, army, hero items…), so no gameplay action has to be
/// instrumented to keep a counter in sync — and a condition can be retuned in
/// src/lib/game/achievements.ts without a backfill. See
/// src/server/actions/achievements.ts.
///
/// The composite unique is the whole concurrency story: claiming inserts the
/// row first and lets the constraint reject a duplicate, so two simultaneous
/// clicks can never both pay out.
model EmpireAchievement {
  id        String   @id @default(cuid())
  empireId  String
  /// Catalog key from ACHIEVEMENTS. Kept as a plain string rather than an enum
  /// so adding an achievement is a code change, not a migration. Keys that fall
  /// out of the catalog are ignored on read.
  key       String
  claimedAt DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // Also serves the "which has this empire claimed" read — no separate index needed.
  @@unique([empireId, key])
}

/// Automatic world decorations — the capstone board on /game/base.
///
/// Deliberately NOT EmpireAchievement. That ladder is *collected*: reaching a
/// goal only unlocks a button, and the reward is paid when the player presses
/// it. These are decorations, not rewards — they light up on their own the
/// moment the empire meets the condition, and there is nothing to press and
/// nothing to pay out. Sharing the achievements table would have meant a player
/// who hit a ceiling and left the reward sitting was shown as not having done
/// it, and would have lost the world record to whoever clicked first.
///
/// A row is stamped the first time the empire is *observed* meeting the
/// condition (see src/server/gloryBoard.ts). `awardedAt` is therefore the
/// arrival time to the nearest page load, which is what makes the earliest row
/// per key a fair world record.
model EmpireGloryAward {
  id        String   @id @default(cuid())
  empireId  String
  /// Key from GLORY_KEYS in src/lib/game/achievements.ts. A plain string for
  /// the same reason EmpireAchievement.key is: adding a capstone is a code
  /// change, not a migration. Keys that fall out of the set are ignored on read.
  key       String
  awardedAt DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // Idempotent awarding: the writer inserts unconditionally and lets this
  // constraint drop the repeat, so two concurrent observations cannot both
  // stamp — and the first stamp is the one that survives.
  @@unique([empireId, key])
  // "Who got here first, server-wide". The unique above starts on empireId, so
  // a key-filtered lookup cannot use it; without this the board sequentially
  // scans on every base-screen load. Ordering by awardedAt makes each record a
  // one-row index read.
  @@index([key, awardedAt])
}

/// Per-empire season-pass state. Exactly one row per empire, reset in place on
/// each daily-update boundary rather than re-created — see
/// src/server/actions/seasonPass.ts.
model SeasonPassProgress {
  id       String @id @default(cuid())
  empireId String @unique

  /// Season the `premium` flag and progress belong to. When the active season
  /// changes, the row is wiped back to a free, zeroed ladder — premium is
  /// bought per season, so a new season means buying again.
  seasonId String?

  /// Premium track purchased. Survives every cycle reset within the season, so
  /// the player is charged once and keeps the gold track open all season.
  premium   Boolean   @default(false)
  premiumAt DateTime?

  /// The daily-update boundary this ladder belongs to. Once
  /// `lastDailyUpdate(now)` moves past it, `xp` and both claimed lists reset
  /// and the payouts grow with the new season day.
  cycleStartedAt DateTime

  /// XP earned in the current cycle only. Tier N unlocks at N × 50.
  xp Int @default(0)

  /// Tiers already collected in the current cycle, per track. Claiming pushes
  /// onto these under a `NOT has` guard, which is what makes a double-claim
  /// impossible without a row lock.
  claimedFree    Int[]
  claimedPremium Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

/**
 * --------------------------- diamond store (real money) ---------------------------
 */

/// Lifecycle of a real-money diamond-package purchase.
enum PurchaseStatus {
  /// Charge created with the provider, not yet confirmed.
  PENDING
  /// Charge succeeded and the diamonds were credited.
  PAID
  /// Charge failed or was declined — no diamonds credited.
  FAILED
  /// A settled charge was refunded or reversed by the provider (PayPal refund
  /// or chargeback). The diamonds are NOT clawed back automatically — a balance
  /// can already have been spent — so an admin decides what to adjust.
  REFUNDED
}

/// One real-money purchase attempt of a diamond package — a full financial
/// audit row. Created PENDING, then settled to PAID (diamonds credited in the
/// same transaction) or FAILED by the payment provider result.
///
/// Everything needed to read a receipt is snapshotted at purchase time, because
/// (a) packages live in code (DIAMOND_PACKAGES), not in rows, and (b) the buyer
/// or their empire may later be renamed or deleted. `empireId` is therefore
/// nullable with onDelete: SetNull — deleting an account never erases its
/// purchase history. `isTest` marks charges that moved no real money (the mock
/// provider), so real revenue can be reported separately.
model DiamondPurchase {
  id            String         @id @default(cuid())
  empireId      String?
  /// Snapshot of the buyer's user id (survives empire/account deletion).
  userId        String?
  /// Snapshot of the buyer's email at purchase time (for receipts/support).
  userEmail     String?
  /// Snapshot of the empire name at purchase time.
  empireName    String?
  /// Package id from DIAMOND_PACKAGES.
  packageId     String
  /// Total diamonds granted (base + bonus), snapshotted at purchase time.
  diamonds      Int
  /// Base diamonds of the package (without the bonus).
  baseDiamonds  Int            @default(0)
  /// Bonus diamonds thrown in on top.
  bonusDiamonds Int            @default(0)
  /// Price actually charged, after any admin discount.
  priceIls      Float
  /// Full list price before the admin discount (for the receipt).
  basePriceIls  Float          @default(0)
  /// Discount percent applied at purchase time.
  discountPct   Float          @default(0)
  /// ISO-4217 currency of the charge.
  currency      String         @default("ILS")
  /// Payment provider that handled the charge ("mock" until a real one is wired).
  provider      String
  /// Provider-side transaction reference, once charged. Unique so the same
  /// reference can never settle twice: today's in-process flow is idempotent on
  /// the internal purchase id, but the documented go-live path is a provider
  /// webhook, and a replayed webhook carrying a reference we have already
  /// credited would otherwise settle a second row and double-credit diamonds.
  /// The future webhook handler must look the purchase up BY THIS FIELD.
  providerRef   String?        @unique
  /// Provider-side id of the money movement itself — for PayPal the *capture*
  /// id, which is what a refund is issued against and what refund/chargeback
  /// webhooks identify the payment by (`providerRef` holds the order id).
  /// Unique for the same anti-replay reason as `providerRef`.
  captureRef    String?        @unique
  /// True when no real money moved (mock provider / PayPal sandbox).
  isTest        Boolean        @default(false)
  status        PurchaseStatus @default(PENDING)
  /// Why the charge failed (only set on FAILED).
  failureReason String?
  /// When the charge settled as PAID.
  paidAt        DateTime?
  /// When a settled charge was refunded or reversed.
  refundedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  empire Empire? @relation(fields: [empireId], references: [id], onDelete: SetNull)

  @@index([empireId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/**
 * ------------------------------ diamond shop ------------------------------
 */

/// A purchasable diamond effect on an empire. Timed buffs (resource boosts,
/// shop discount) use `magnitude` + `activeUntil`; cooldown-only spells
/// (bank interest) use `readyAt`. One row per (empire, kind).
enum DiamondEffectKind {
  RESOURCE_BOOST_GOLD
  RESOURCE_BOOST_WOOD
  RESOURCE_BOOST_IRON
  RESOURCE_BOOST_STONE
  SHOP_DISCOUNT
  BANK_INTEREST
  TURN_PACK_1
  TURN_PACK_2
  TURN_PACK_3
  TURN_PACK_4
  /// Paid raid shields: while active, a winning attacker takes no plunder
  /// (RESOURCES) / captures no soldiers (SOLDIERS) from this empire.
  SHIELD_RESOURCES
  SHIELD_SOLDIERS
}

model DiamondEffect {
  id          String            @id @default(cuid())
  empireId    String
  kind        DiamondEffectKind
  /// Boost/discount percent (0 for cooldown-only spells).
  magnitude   Float             @default(0)
  /// When a timed buff expires (null for cooldown-only spells).
  activeUntil DateTime?
  /// When a cooldown-only spell becomes usable again (null for buffs).
  readyAt     DateTime?
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
  @@index([empireId, activeUntil])
}

/**
 * ------------------------------ guilds ------------------------------
 */

enum GuildRole {
  LEADER
  DEPUTY
  MEMBER
}

/// The four guild spells sold in the guild shop. Each has a per-guild level
/// (level = bonus %, starts at 1, capped at 30) that members upgrade with
/// diamonds; casting one grants the caster a 24h personal buff.
enum GuildSpellType {
  ATTACK
  DEFENSE
  SPY
  RESOURCES
}

model Guild {
  id            String   @id @default(cuid())
  name          String   @unique
  /// Member capacity = 1 + level, so a fresh guild (level 1) holds 2 members.
  capacityLevel Int      @default(1)
  /// Guild aid level — each level adds 1% of the guild's total military power
  /// as flat combat power for every member in battle, up to 10%. Guilds have no
  /// treasury: whoever wants the upgrade pays for it from their own gold.
  aidLevel      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members GuildMember[]
  spells  GuildSpell[]
  invites GuildInvite[]
}

/// A standing invitation for one guildless empire to join one guild.
///
/// Joining is invitation-only: `joinGuild` consumes a live row here, so the
/// browse list on /game/guild is a directory, not a door. The invitation used
/// to be nothing but an inbox message, which meant the message was decoration —
/// the join action never looked at it, and anyone holding a guild id could walk
/// into any guild uninvited.
model GuildInvite {
  id          String   @id @default(cuid())
  guildId     String
  empireId    String
  /// Who sent it. SetNull so a deleted recruiter does not void the invitation.
  invitedById String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  guild     Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  empire    Empire  @relation("GuildInviteTo", fields: [empireId], references: [id], onDelete: Cascade)
  invitedBy Empire? @relation("GuildInviteFrom", fields: [invitedById], references: [id], onDelete: SetNull)

  /// One standing invitation per guild per player — re-inviting refreshes it.
  @@unique([guildId, empireId])
  @@index([empireId, expiresAt])
}

model GuildMember {
  id        String    @id @default(cuid())
  guildId   String
  empireId  String    @unique
  role      GuildRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model GuildSpell {
  id        String         @id @default(cuid())
  guildId   String
  type      GuildSpellType
  level     Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, type])
}

/// An active (or expired, until cleaned up) 24h spell buff on an empire.
/// The bonus % is snapshotted at cast time.
model GuildSpellBuff {
  id        String         @id @default(cuid())
  empireId  String
  type      GuildSpellType
  bonusPct  Float
  expiresAt DateTime
  createdAt DateTime       @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@index([empireId, expiresAt])
}

/**
 * ---------------------------- guild war ----------------------------
 */

enum GuildWarStatus {
  /// Registered, running, or waiting to be settled.
  SCHEDULED
  /// Finished with enough guilds; ranks and prizes are written.
  SETTLED
  /// Finished with fewer than GUILD_WAR_MIN_GUILDS entrants. Nobody scores,
  /// nobody is paid — a single guild showing up wins nothing.
  CANCELLED
}

/// One nightly guild campaign: a 30-minute window (19:30-20:00 Jerusalem) that
/// the game fights **by itself**. Guilds enrol and then watch: every minute the
/// system throws one clash per guild, resolves it with the real battle maths
/// and posts it to the live feed. No player ever presses anything.
///
/// Rows are created lazily by the first guild to register, advanced lazily by
/// any request that arrives during the window, and settled lazily by the first
/// one after it closes. The game has no cron and nothing here may assume one.
model GuildWar {
  id             String         @id @default(cuid())
  /// Window open. Unique so concurrent registrations converge on one row per
  /// night instead of racing two wars into existence.
  startsAt       DateTime       @unique
  endsAt         DateTime
  status         GuildWarStatus @default(SCHEDULED)
  /// How many of the GUILD_WAR_ROUNDS minute-rounds have been fought. This is
  /// the resume point for the lazy simulation: a request materialises every
  /// round that has come due since, under a row lock and guarded on this
  /// counter, so two readers arriving together can never fight one round twice.
  resolvedRounds Int            @default(0)
  settledAt      DateTime?
  createdAt      DateTime       @default(now())

  entries GuildWarEntry[]
  clashes GuildWarClash[]

  /// Drives both the "wars in progress" and "wars due for settlement" sweeps.
  @@index([status, endsAt])
}

/// A guild's enrolment in one war, and its running score.
model GuildWarEntry {
  id        String @id @default(cuid())
  warId     String
  /// Soft reference - deliberately no foreign key. A guild that disbands the
  /// morning after must not erase the night it won, so the war keeps its own
  /// snapshot of the name and simply finds no members left to pay.
  guildId   String
  guildName String

  score  Int @default(0)
  /// Clashes this guild won — broke through as attacker, or held as defender.
  wins   Int @default(0)
  /// Clashes it lost on either side.
  losses Int @default(0)

  /// The guild's combined military power, snapshotted at enrolment and
  /// refreshed on every round the simulation materialises.
  ///
  /// Stored rather than computed on read because the board polls every six
  /// seconds and summing it live means loading every member's army and every
  /// weapon row on each poll. advanceWar already has the figures in hand.
  power Int @default(0)

  /// Final placement, written at settlement (1 = champion).
  rank        Int?
  /// Prize snapshot, written at settlement so the result page reads the same
  /// after the prize table is retuned.
  rewardLabel String?

  createdAt DateTime @default(now())

  war GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@unique([warId, guildId])
  @@index([warId, score])
}

/// One clash the system fought inside a war — the live feed, and the source of
/// every score. Both sides are snapshotted so the war reads the same a month
/// later, whoever has since left, renamed or disbanded.
model GuildWarClash {
  id    String @id @default(cuid())
  warId String
  /// Which minute of the campaign this was fought in (0-based).
  round Int

  attackerGuildId   String
  attackerGuildName String
  defenderGuildId   String
  defenderGuildName String

  attackerEmpireId String
  attackerName     String
  defenderEmpireId String
  defenderName     String

  attackerPower Float
  defenderPower Float
  /// True when the attacker broke through. Points go to the attacker on a
  /// breakthrough and to the defender on a hold — one field, two owners.
  won           Boolean
  points        Int

  /// The round's scheduled instant, not the moment the row was written: rounds
  /// are materialised late whenever nobody was watching, and a feed stamped
  /// with the catch-up time would show half an hour of war in one second.
  createdAt DateTime

  war GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  /// The live feed.
  @@index([warId, createdAt])
  /// Idempotent catch-up + the per-round replay.
  @@index([warId, round])
  /// The fighter board.
  @@index([warId, attackerEmpireId])
  @@index([warId, defenderEmpireId])
}

enum MessageKind {
  SYSTEM
  BATTLE
  SPY
  /// Player-to-player mail, written from the messages screen.
  PLAYER
}

/// Inbox message for an empire — system announcements, combat alerts
/// ("you were attacked", "a spy was caught in your territory") and mail sent
/// by other players.
model Message {
  id             String      @id @default(cuid())
  empireId       String
  /// Author of a PLAYER message. Null for anything the game itself wrote.
  /// SetNull (not Cascade) so a deleted sender does not erase the recipient's
  /// inbox — the message survives as "שחקן שנמחק".
  senderEmpireId String?
  kind           MessageKind @default(SYSTEM)
  title          String
  body           String
  /// Optional in-game link, e.g. the full battle report page.
  href           String?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  empire Empire  @relation("MessageInbox", fields: [empireId], references: [id], onDelete: Cascade)
  sender Empire? @relation("MessageSender", fields: [senderEmpireId], references: [id], onDelete: SetNull)

  @@index([empireId, readAt])
  @@index([empireId, createdAt])
  @@index([senderEmpireId, createdAt])
}

enum HeroRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

/// The character archetype chosen at signup — each carries its own passive
/// bonus (see HERO_CLASS_META in src/lib/game/hero.ts).
enum HeroClass {
  WARLORD
  GUARDIAN
  MERCHANT
  SHADOW
}

enum HeroItemSlot {
  SWORD
  GAUNTLETS
  WINGS
  HELMET
  ARMOR
  SHIELD
  PANTS
  BOOTS
  RELIC
}

model Hero {
  id                  String    @id @default(cuid())
  empireId            String    @unique
  heroClass           HeroClass @default(WARLORD)
  level               Int       @default(1)
  xp                  Int       @default(0)
  unspentPoints       Int       @default(0)
  attackPoints        Int       @default(0)
  defensePoints       Int       @default(0)
  resourcePoints      Int       @default(0)
  resets              Int       @default(0)
  /// Hero health, 0–100. Every attack that breaches this empire's defence
  /// wounds the hero (see HERO_DAMAGE_PER_LOST_DEFENSE); at 0 he is dead.
  health              Int       @default(100)
  /// When the hero fell (health hit 0), else null. He rises by himself an hour
  /// later — applied lazily by applyPendingUpdates — or instantly for diamonds.
  /// While dead he grants **no** bonuses at all (see heroBonuses).
  diedAt              DateTime?
  /// The season in which the diamond points-reset was last used (once/season).
  pointsResetSeasonId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empire Empire     @relation(fields: [empireId], references: [id], onDelete: Cascade)
  items  HeroItem[]
}

model HeroItem {
  id        String       @id @default(cuid())
  heroId    String
  slot      HeroItemSlot
  level     Int
  rarity    HeroRarity
  equipped  Boolean      @default(false)
  createdAt DateTime     @default(now())

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
}

/// The expedition the hero is currently away on, or the finished one waiting to
/// be collected. Catalog and every balance formula: src/lib/game/heroQuests.ts.
///
/// **At most one row per empire, and that is the feature's core rule** — there
/// is one hero, so he can only be in one place. The unique index on `empireId`
/// is what enforces it: `startHeroQuest` also takes the empire row lock before
/// it checks, but the index is the backstop that holds even if a future caller
/// forgets to.
///
/// The payout is snapshotted at *departure* rather than derived on collect, so
/// the board can promise an exact haul before the player commits turns to it,
/// and a city founded (or lost) mid-quest cannot change the deal. The loot roll
/// is the one thing left to collect time — it needs the hero's level *then*.
///
/// The row IS the claim: collecting deletes it under a guard on `endsAt`, so a
/// double-click cannot pay twice.
model HeroQuest {
  id       String @id @default(cuid())
  empireId String @unique

  /// Quest tier (1..MAX_CITIES) — decides duration, turn cost, XP and loot odds.
  tier Int

  startedAt  DateTime @default(now())
  endsAt     DateTime
  turnsSpent Int

  /// The haul, rolled and frozen at departure — never sent to the client, so
  /// the board cannot leak what is coming (see lib/game/heroQuests.ts).
  /// `fortune` is the luck band that was drawn; the homecoming line names it.
  fortune        String @default("plain")
  rewardGold     Float  @default(0)
  rewardWood     Float  @default(0)
  rewardIron     Float  @default(0)
  rewardStone    Float  @default(0)
  rewardCitizens Int    @default(0)
  rewardSlaves   Int    @default(0)
  rewardXp       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

/**
 * ------------------------------ potions ------------------------------
 */

/// The four brews looted from won battles. Each is a *timed* effect on the
/// whole empire, not an item: drinking one starts (or extends) a window, and
/// everything else in the game only ever asks "is this kind active right now?".
/// Catalog, durations and drop odds: src/lib/game/potions.ts.
enum PotionKind {
  DOUBLE_XP
  DOUBLE_RESOURCES
  HERO_INVULNERABLE
  FORGE_DISCOUNT
}

/// Unopened potions on the belt — one row per (empire, kind) holding how many
/// are in hand. Counts, not one row per bottle: potions are fungible and the
/// belt shows a stack with a badge, so a row per bottle would buy nothing.
model PotionStack {
  id        String     @id @default(cuid())
  empireId  String
  kind      PotionKind
  count     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
}

/// A potion currently in effect. One row per (empire, kind); drinking another
/// of the same kind pushes `expiresAt` further out rather than being wasted.
/// Expiry is lazy — every reader filters on `expiresAt > now`, so no sweeper
/// job is needed and an offline player's buff runs out on its own.
model PotionEffect {
  id        String     @id @default(cuid())
  empireId  String
  kind      PotionKind
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
  @@index([empireId, expiresAt])
}

enum BuildingType {
  GOLD_MINE
  WOOD_CAMP
  IRON_MINE
  STONE_QUARRY
  BARRACKS
  SPY_CENTER
}

model Building {
  id             String       @id @default(cuid())
  empireId       String
  type           BuildingType
  level          Int          @default(1)
  slavesAssigned Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, type])
}

model Army {
  id         String   @id @default(cuid())
  empireId   String   @unique
  soldiers   Int      @default(0)
  spies      Int      @default(0)
  mineSlaves Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

enum ResourceStorageType {
  GOLD
  WOOD
  IRON
  STONE
}

model ResourceStorage {
  id           String              @id @default(cuid())
  empireId     String
  resourceType ResourceStorageType
  level        Int                 @default(1)
  storedAmount Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, resourceType])
