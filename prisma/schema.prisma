enum EmpireUpgradeType {
  CITIZEN_GROWTH
  DIAMOND_YIELD
  INTELLIGENCE
  BANK_DEPOSIT_COUNT
  BANK_DAILY_INTEREST
  TURNS_PER_REGULAR_UPDATE
  WHEEL_LUCK
}

model EmpireUpgrade {
  id        String            @id @default(cuid())
  empireId  String
  type      EmpireUpgradeType
  level     Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, type])
}

enum WeaponCategory {
  ATTACK
  DEFENSE
  SPY
}

model EmpireWeapon {
  id        String   @id @default(cuid())
  empireId  String
  weaponKey String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, weaponKey])
}

model EmpireWeaponUnlock {
  id           String         @id @default(cuid())
  empireId     String
  category     WeaponCategory
  unlockedTier Int            @default(2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, category])
